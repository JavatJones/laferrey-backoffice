{
  "name": "laferrey-backoffice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:linked": "sh -c 'set -a; . ./.env.supabase-cli; set +a; exec supabase \"$@\"' --",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "seed:admin": "tsx --conditions=react-server --env-file=.env scripts/seed-admin.ts",
    "sync:orders": "tsx --conditions=react-server --env-file=.env scripts/shopify/sync-orders.ts",
    "shopify:webhooks": "tsx --conditions=react-server --env-file=.env scripts/shopify/register-webhooks.ts",
    "shopify:test-orders": "tsx --conditions=react-server --env-file=.env scripts/shopify/seed-test-orders.ts",
    "shopify:enable-pickup": "tsx --conditions=react-server --env-file=.env scripts/shopify/enable-pickup.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "nodemailer": "10.1.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.90.0",
    "recharts": "3.8.0",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
