# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# Shopify (Admin API, client credentials grant)
# Dominio canónico de la tienda: los webhooks llegan con él en X-Shopify-Shop-Domain.
SHOPIFY_STORE_DOMAIN=ubiqat-wz.myshopify.com
# Client ID y Client secret de la app en dev.shopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Canales donde se publican los productos activos, separados por coma (Tienda online por defecto).
SHOPIFY_PUBLICATION_IDS=gid://shopify/Publication/186569490525
# Refleja "listo para recoger" y "entregado" en Shopify.
SHOPIFY_FULFILLMENT_SYNC=false
# true en desarrollo, false en producción (RN-18).
INCLUDE_TEST_ORDERS=true

# Supabase. En local: `pnpm exec supabase status` muestra la URL y las llaves.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… — solo servidor; nunca en el cliente.
SUPABASE_SECRET_KEY=

# Cadena aleatoria larga; protege GET /api/cron/sync-orders.
CRON_SECRET=

# Correo saliente por SMTP (código de recogida, RN-27).
# Gmail: smtp.gmail.com:465, SMTP_USER = la cuenta, SMTP_PASSWORD = contraseña de aplicación.
# Local: el buzón de Supabase (Mailpit) en 127.0.0.1:54325 sin usuario; los correos se ven en http://127.0.0.1:54324
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opcional. Solo el nombre ("La Ferrey") usa la cuenta de SMTP_USER; con dirección, en Gmail
# debe ser la cuenta o un alias verificado. Ej. "LaFerrey <pedidos@laferrey.mx>"
EMAIL_FROM=
# Cadena aleatoria larga para cifrar los códigos de recogida.
PICKUP_CODE_SECRET=
